[Unit]
Description=TrailerAutomation Gateway (Blazor + REST + mDNS)
Documentation=https://github.com/mnichols1202/TrailerAutomation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/TrailerAutomationGateway
ExecStart=/home/pi/TrailerAutomationGateway/TrailerAutomationGateway
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=15
SyslogIdentifier=trailer-gateway

Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=DOTNET_NOLOGO=1

NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
